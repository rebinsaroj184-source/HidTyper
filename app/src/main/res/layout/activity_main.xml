<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp">

    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Status: Not registered"
        android:textSize="16sp"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/registerBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="1. Register as HID Keyboard" />

    <Button
        android:id="@+id/pairBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="2. Show Paired Devices" />

    <EditText
        android:id="@+id/startNum"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Start number"
        android:inputType="number"
        android:text="1"
        android:layout_marginTop="16dp" />

    <EditText
        android:id="@+id/endNum"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="End number"
        android:inputType="number"
        android:text="1000000"
        android:layout_marginTop="8dp" />

    <EditText
        android:id="@+id/delayMs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Delay per number (ms)"
        android:inputType="number"
        android:text="150"
        android:layout_marginTop="8dp" />

    <Button
        android:id="@+id/startBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="3. Start Typing" />

    <Button
        android:id="@+id/stopBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Stop" />

    <TextView
        android:id="@+id/progressText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Progress: -" />

</LinearLayout>
